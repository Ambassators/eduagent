{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist/main", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/main", "src/shared.ts"]
}
