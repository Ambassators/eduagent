{
  "name": "codex-voice",
  "productName": "Codex Voice",
  "version": "2.0.0",
  "description": "A local document workspace with subscription GPT-Live voice, Codex Think, and interactive demonstrations",
  "author": "Codex Voice contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json && node scripts/copy-pdf-assets.mjs && node scripts/copy-voice-assets.mjs && node scripts/copy-browser-assets.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:glasstex": "npm run build && node scripts/glasstex-smoke.mjs",
    "test:glasstex:editing": "electron tests/glasstex-editing.electron.cjs",
    "test:rendering": "npm run build && electron tests/rendering.electron.cjs",
    "assets:orb-video": "electron scripts/generate-orb-video.cjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "extensions": "node scripts/copy-browser-assets.mjs",
    "test:browser": "electron scripts/browser-smoke.mjs",
    "test:browser:ui": "electron scripts/browser-ui-smoke.mjs",
    "test:extensions": "node scripts/browser-extension-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "@openai/codex": "0.160.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@ricky0123/vad-web": "0.0.31",
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.1",
    "docx": "^9.9.0",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "mermaid": "^12.1.0",
    "onnxruntime-web": "1.22.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.0",
    "word-extractor": "^1.0.4",
    "ws": "^8.22.0"
  },
  "overrides": {
    "katex": "$katex",
    "mammoth": {
      "argparse": "^2.0.1"
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.codexvoice.desktop",
    "productName": "Codex Voice",
    "artifactName": "Codex-Voice-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/**/*",
      "node_modules/@napi-rs/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Codex Voice sends microphone audio to your subscription voice session only while you are connected."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
